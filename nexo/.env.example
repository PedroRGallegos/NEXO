# Clave del proveedor (Groq: empieza por gsk_; OpenAI: sk-). No subir .env a GitHub.
LLM_API_KEY=

# --- Groq (compatible con la API de OpenAI) ---
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=openai/gpt-oss-120b

# --- OpenAI (alternativa: comenta las dos líneas de Groq y descomenta estas) ---
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o

# Tope normal de cada respuesta (tokens).
LLM_MAX_TOKENS=500
# Si una respuesta se corta en el tope normal, se continúa automáticamente hasta este total (0 = no ampliar).
LLM_MAX_TOKENS_AMPLIADO=1000
# Modelos gpt-oss (Groq): "low" piensa menos y deja más tokens para la respuesta. Vacío = no se envía.
LLM_REASONING_EFFORT=low
# Instrucción para que las respuestas quepan en el tope. Vacío = sin instrucción. Si no se define, usa la de por defecto.
# LLM_SYSTEM=Responde en español, de forma clara y concisa.
LLM_TEMPERATURE=0.7
LLM_COST_PER_1K_OUTPUT=0.008
